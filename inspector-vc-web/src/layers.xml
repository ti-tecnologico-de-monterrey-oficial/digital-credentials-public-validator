<layers xmlns="http://www.springframework.org/schema/boot/layers"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/boot/layers
	                    https://www.springframework.org/schema/boot/layers/layers-3.5.xsd">
	<application>
		<into layer="spring-boot-loader">
			<include>org/springframework/boot/loader/**</include>
		</into>
		<into layer="application" />
	</application>
	<dependencies>
		<!-- The reactor modules (inspector-vc, inspector-clr, inspector-tcp-vc, inspector-trusted)
			hold most of the code and change with it, so they travel with the application, not with
			the libraries. -->
		<into layer="application">
			<includeModuleDependencies />
		</into>
		<!-- No snapshot-dependencies layer: the build has no SNAPSHOT libraries, and an empty layer
			copied with COPY breaks the classic Docker builder that az acr build uses ("failed to get
			layer ... layer does not exist"). A SNAPSHOT library would land in dependencies. -->
		<into layer="dependencies" />
	</dependencies>
	<layerOrder>
		<layer>dependencies</layer>
		<layer>spring-boot-loader</layer>
		<layer>application</layer>
	</layerOrder>
</layers>
